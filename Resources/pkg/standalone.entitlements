<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Entitlements for the standalone build.

    The hardened runtime is required for notarisation, and under it a process gets
    no microphone access unless it asks for it — so the standalone, which records
    from an input device, needs the audio-input entitlement or it will open with a
    dead input. The plug-in bundles need no entitlements of their own: they run
    inside the host's process and inherit the host's permissions.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
